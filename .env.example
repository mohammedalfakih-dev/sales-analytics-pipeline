# Optional runtime settings. Local sample mode needs none of these.
# Load this file explicitly: uv run --env-file .env python -m src.pipeline
INPUT_SOURCE=local
DATA_DIR=data/sample
OUTPUT_DIR=reports/generated
UPLOAD_TO_AZURE=false
# Required only for the relevant Azure transfer mode:
AZURE_STORAGE_ACCOUNT_URL=
AZURE_INPUT_CONTAINER=
AZURE_OUTPUT_CONTAINER=
